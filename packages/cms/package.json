{
  "name": "@linkcharsoft/cms",
  "version": "0.1.0",
  "description": "Linkchar CMS: content schema, Supabase storage, editor panel and site readers for Next.js projects",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linkcharsoft/linkchar-cms.git",
    "directory": "packages/cms"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "exports": {
    "./core": "./src/core/index.ts",
    "./core/opening-hours": "./src/core/kinds/openingHours.ts",
    "./publish/amplify": "./src/publish/amplify.ts",
    "./publish/mock": "./src/publish/mock.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "linkchar-cms": "./cli/linkchar-cms.js"
  },
  "files": [
    "cli",
    "src",
    "supabase",
    "!**/__tests__"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@types/node": "24.13.3",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.117.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "server-only": "^0.0.1"
  }
}
