{
  "name": "@linkcharsoft/cms",
  "version": "0.2.0",
  "description": "Linkchar CMS: content schema, Supabase storage, editor panel and site readers for Next.js projects",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linkcharsoft/linkchar-cms.git",
    "directory": "packages/cms"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.sass"
  ],
  "exports": {
    "./core": "./src/core/index.ts",
    "./core/opening-hours": "./src/core/kinds/openingHours.ts",
    "./server": "./src/server/index.ts",
    "./publish/amplify": "./src/publish/amplify.ts",
    "./publish/mock": "./src/publish/mock.ts",
    "./panel/styles.css": "./src/panel/theme/styles.css",
    "./tailwind": "./tailwind/preset.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "linkchar-cms": "./cli/linkchar-cms.js"
  },
  "files": [
    "cli",
    "src",
    "supabase",
    "tailwind",
    "!**/__tests__",
    "!**/__integration__"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "driver.js": "1.8.0",
    "formik": "2.4.9",
    "jiti": "2.7.0",
    "motion": "12.42.2",
    "primeicons": "7.0.0",
    "primelocale": "2.4.0",
    "primereact": "10.9.9",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.1.2",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sass": "1.105.1",
    "server-only": "0.0.1",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.117.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.100.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.0"
  }
}
