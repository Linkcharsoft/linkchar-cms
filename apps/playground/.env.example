# Local Supabase (pnpm db:start); `pnpm db:status` prints the keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public origin of the site: canonical URLs, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Empty build hook: publishing uses the mock build, which reports after CMS_MOCK_BUILD_SECONDS.
CMS_BUILD_HOOK_URL=
CMS_BUILD_WEBHOOK_SECRET=
CMS_MOCK_BUILD_RESULT=success
CMS_MOCK_BUILD_SECONDS=15
